{
  "$schema": "https://opencode.ai/config.json",

  // Format files after the agent edits them, using any formatter the project
  // provides. Built-ins activate only when their executable is available.
  "formatter": true,

  // Keep the file watcher out of generated and dependency directories.
  // Mirror the noisy entries from .gitignore here.
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.venv/**",
      "**/vendor/**",
      "**/target/**"
    ]
  },

  "permissions": [
    // Ask by default, allow read-only inspection and the standard make targets,
    // and always block irreversible or privileged operations. The last
    // matching rule wins, so the denies come last.
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "make test*", "effect": "allow" },
    { "action": "shell", "resource": "make lint*", "effect": "allow" },
    { "action": "shell", "resource": "make format*", "effect": "allow" },
    { "action": "shell", "resource": "make check*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -f*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },

    // Keep secrets out of model context. Built-in defaults already ask before
    // reading .env files; these rules cover common key material.
    { "action": "read", "resource": "secrets/*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*.key", "effect": "ask" }
  ]

  // Add project MCP servers here when needed, for example:
  // "mcp": {
  //   "servers": {
  //     "docs": { "type": "remote", "url": "https://example.com/mcp" }
  //   }
  // }
}
